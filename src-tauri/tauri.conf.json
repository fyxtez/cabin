{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cabin",
  "version": "0.1.0",
  "identifier": "com.fyxtez.cabin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cabin — Service Control",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 520,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}